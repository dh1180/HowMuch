---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = "HowMuch — 필요한 계산, 바로",
  description = "평, 인터넷 속도, 데이터 용량, 온도, 연비, 학점까지. 자주 쓰는 계산을 빠르고 간단하게.",
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const canonical = Astro.site ? new URL(canonicalPath, Astro.site) : undefined;
const ogImage = Astro.site ? new URL("/og-default.png", Astro.site) : undefined;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "HowMuch",
  description,
  inLanguage: "ko-KR",
  ...(Astro.site ? { url: Astro.site.href } : {}),
};
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#4f46e5" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="HowMuch" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
