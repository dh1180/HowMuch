---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="페이지를 찾을 수 없습니다 | HowMuch" description="요청한 페이지를 찾을 수 없습니다.">
  <section class="shell py-24 text-center">
    <p class="text-sm font-extrabold text-indigo-600">404</p>
    <h1 class="mt-3 text-3xl font-black tracking-tight">이 계산기는 아직 없어요.</h1>
    <p class="mt-3 text-slate-500">홈에서 필요한 도구를 다시 찾아보세요.</p>
    <a href="/" class="btn btn-primary mt-7">모든 도구 보기</a>
  </section>
</BaseLayout>
