---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolCard from "../components/ToolCard.astro";
import { categories, tools } from "../data/tools";
---
<BaseLayout>
  <section class="shell pt-14 md:pt-20">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 text-sm font-bold text-indigo-700 bg-indigo-50 px-3 py-1.5 rounded-full">⚡ 빠르고 간단한 생활 계산기</span>
      <h1 class="mt-5 text-4xl md:text-6xl font-black tracking-[-.055em] leading-[1.05]">
        이거, <span class="text-indigo-600">몇이야?</span>
      </h1>
      <p class="mt-5 text-lg md:text-xl leading-8 text-slate-600">
        평부터 인터넷 속도, 데이터 용량, 연비, 학점까지.<br class="hidden sm:block" />
        검색하고 입력하면 바로 계산됩니다.
      </p>
    </div>

    <div class="mt-9 max-w-3xl card p-3 flex items-center gap-3 focus-within:ring-4 focus-within:ring-indigo-100 transition">
      <span class="pl-2 text-slate-400" aria-hidden="true">⌕</span>
      <input id="tool-search" type="search" placeholder="예: 평, 500Mbps, 학점, 온도" class="w-full bg-transparent outline-none py-2.5 text-base" autocomplete="off" />
      <kbd class="hidden sm:inline-flex text-[11px] text-slate-400 border border-slate-200 rounded-lg px-2 py-1">/</kbd>
    </div>

    <div class="mt-5 flex gap-2 overflow-x-auto pb-1" id="category-filter" aria-label="도구 카테고리">
      {categories.map((category, index) => (
        <button
          type="button"
          data-category={category}
          class:list={[
            "category-btn shrink-0 px-4 py-2 rounded-full text-sm font-bold border transition",
            index === 0 ? "bg-slate-900 text-white border-slate-900" : "bg-white text-slate-600 border-slate-200 hover:border-slate-300",
          ]}
        >
          {category}
        </button>
      ))}
    </div>
  </section>

  <section class="shell mt-9" aria-labelledby="tools-title">
    <div class="flex items-end justify-between gap-4 mb-4">
      <div>
        <h2 id="tools-title" class="text-xl font-extrabold tracking-tight">자주 쓰는 도구</h2>
        <p id="tool-count" class="text-sm text-slate-500 mt-1">{tools.length}개의 도구</p>
      </div>
    </div>
    <div class="tool-grid" id="tool-grid">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </div>
    <div id="empty-state" class="hidden card py-14 px-6 text-center">
      <p class="font-extrabold text-lg">찾는 도구가 아직 없어요.</p>
      <p class="mt-2 text-sm text-slate-500">다른 검색어로 찾아보세요.</p>
    </div>
  </section>

  <section id="about" class="shell mt-20">
    <div class="card p-6 md:p-8 grid md:grid-cols-3 gap-6">
      <div>
        <div class="text-2xl">⚡</div>
        <h3 class="font-extrabold mt-3">즉시 계산</h3>
        <p class="text-sm leading-6 text-slate-600 mt-2">페이지를 오가는 과정 없이 입력하는 순간 결과를 확인합니다.</p>
      </div>
      <div>
        <div class="text-2xl">◫</div>
        <h3 class="font-extrabold mt-3">로그인 없음</h3>
        <p class="text-sm leading-6 text-slate-600 mt-2">계정 생성 없이 바로 사용할 수 있습니다.</p>
      </div>
      <div>
        <div class="text-2xl">⌁</div>
        <h3 class="font-extrabold mt-3">브라우저에서 처리</h3>
        <p class="text-sm leading-6 text-slate-600 mt-2">입력한 값은 계산을 위해 외부 서버로 전송하지 않습니다.</p>
      </div>
    </div>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>("#tool-search");
    const cards = [...document.querySelectorAll<HTMLElement>(".tool-card")];
    const buttons = [...document.querySelectorAll<HTMLButtonElement>(".category-btn")];
    const count = document.querySelector<HTMLElement>("#tool-count");
    const empty = document.querySelector<HTMLElement>("#empty-state");
    let activeCategory = "전체";

    const normalize = (value: string) => value.toLowerCase().replaceAll(" ", "");

    function filterTools() {
      const query = normalize(search?.value ?? "");
      let visible = 0;

      cards.forEach((card) => {
        const haystack = normalize(
          [card.dataset.name, card.dataset.category, card.dataset.keywords].filter(Boolean).join(" ")
        );
        const categoryMatch = activeCategory === "전체" || card.dataset.category === activeCategory;
        const searchMatch = !query || haystack.includes(query);
        const show = categoryMatch && searchMatch;
        card.classList.toggle("hidden", !show);
        if (show) visible++;
      });

      if (count) count.textContent = `${visible}개의 도구`;
      empty?.classList.toggle("hidden", visible !== 0);
    }

    search?.addEventListener("input", filterTools);
    buttons.forEach((button) => button.addEventListener("click", () => {
      activeCategory = button.dataset.category ?? "전체";
      buttons.forEach((b) => {
        const selected = b === button;
        b.classList.toggle("bg-slate-900", selected);
        b.classList.toggle("text-white", selected);
        b.classList.toggle("border-slate-900", selected);
        b.classList.toggle("bg-white", !selected);
        b.classList.toggle("text-slate-600", !selected);
        b.classList.toggle("border-slate-200", !selected);
      });
      filterTools();
    }));

    document.addEventListener("keydown", (event) => {
      if (event.key === "/" && document.activeElement?.tagName !== "INPUT") {
        event.preventDefault();
        search?.focus();
      }
    });
  </script>
</BaseLayout>
