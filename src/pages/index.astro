---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolCard from "../components/ToolCard.astro";
import { categories, tools } from "../data/tools";
---
<BaseLayout>
  <section class="hero-wrap">
    <div class="shell">
      <div class="hero-panel">
        <div class="hero-copy">
          <span class="hero-eyebrow">⚡ 자주 쓰는 계산을 한곳에서</span>
          <h1>이거, <span>몇이야?</span></h1>
          <p>
            평부터 인터넷 속도, 데이터 용량, 연비, 학점까지.<br class="hidden sm:block" />
            필요한 값을 입력하면 바로 계산됩니다.
          </p>
        </div>

        <div class="hero-search">
          <span class="search-icon" aria-hidden="true">⌕</span>
          <input
            id="tool-search"
            type="search"
            placeholder="평, 500Mbps, 학점, 온도 검색"
            autocomplete="off"
          />
          <kbd>/</kbd>
        </div>

        <div class="category-scroller" id="category-filter" aria-label="도구 카테고리">
          {categories.map((category, index) => (
            <button
              type="button"
              data-category={category}
              class:list={[
                "category-btn",
                index === 0 ? "is-active" : "",
              ]}
            >
              {category}
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="shell tools-section" aria-labelledby="tools-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">TOOLS</p>
        <h2 id="tools-title">자주 쓰는 도구</h2>
      </div>
      <p id="tool-count">{tools.length}개의 도구</p>
    </div>

    <div class="tool-grid" id="tool-grid">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </div>

    <div id="empty-state" class="hidden empty-state">
      <div class="empty-icon">⌕</div>
      <p class="empty-title">찾는 도구가 아직 없어요.</p>
      <p class="empty-description">다른 검색어로 다시 찾아보세요.</p>
    </div>
  </section>

  <section id="about" class="shell about-section">
    <div class="about-heading">
      <p class="section-kicker">WHY HOWMUCH</p>
      <h2>계산만 빠르게, 나머지는 가볍게.</h2>
    </div>

    <div class="feature-grid">
      <article class="feature-card">
        <span class="feature-icon">⚡</span>
        <div>
          <h3>즉시 계산</h3>
          <p>입력하는 순간 결과를 바로 확인할 수 있습니다.</p>
        </div>
      </article>

      <article class="feature-card">
        <span class="feature-icon">○</span>
        <div>
          <h3>로그인 없음</h3>
          <p>회원가입이나 계정 생성 없이 바로 사용할 수 있습니다.</p>
        </div>
      </article>

      <article class="feature-card">
        <span class="feature-icon">⌁</span>
        <div>
          <h3>브라우저에서 처리</h3>
          <p>입력한 값은 계산을 위해 외부 서버로 전송하지 않습니다.</p>
        </div>
      </article>
    </div>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>("#tool-search");
    const cards = [...document.querySelectorAll<HTMLElement>(".tool-card")];
    const buttons = [...document.querySelectorAll<HTMLButtonElement>(".category-btn")];
    const count = document.querySelector<HTMLElement>("#tool-count");
    const empty = document.querySelector<HTMLElement>("#empty-state");
    let activeCategory = "전체";

    const normalize = (value: string) => value.toLowerCase().replaceAll(" ", "");

    function filterTools() {
      const query = normalize(search?.value ?? "");
      let visible = 0;

      cards.forEach((card) => {
        const haystack = normalize(
          [card.dataset.name, card.dataset.category, card.dataset.keywords]
            .filter(Boolean)
            .join(" ")
        );
        const categoryMatch =
          activeCategory === "전체" || card.dataset.category === activeCategory;
        const searchMatch = !query || haystack.includes(query);
        const show = categoryMatch && searchMatch;

        card.classList.toggle("hidden", !show);
        if (show) visible++;
      });

      if (count) count.textContent = `${visible}개의 도구`;
      empty?.classList.toggle("hidden", visible !== 0);
    }

    search?.addEventListener("input", filterTools);

    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        activeCategory = button.dataset.category ?? "전체";

        buttons.forEach((item) => {
          item.classList.toggle("is-active", item === button);
        });

        filterTools();
      })
    );

    document.addEventListener("keydown", (event) => {
      if (
        event.key === "/" &&
        document.activeElement?.tagName !== "INPUT" &&
        document.activeElement?.tagName !== "TEXTAREA"
      ) {
        event.preventDefault();
        search?.focus();
      }
    });
  </script>
</BaseLayout>
