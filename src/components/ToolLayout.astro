---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  category: string;
  note?: string;
}

const { title, description, category, note } = Astro.props;
---
<BaseLayout title={title + " | HowMuch"} description={description}>
  <section class="shell pt-10 md:pt-14">
    <a href="/" class="text-sm font-semibold text-slate-500 hover:text-indigo-700">← 모든 도구</a>
    <div class="mt-6 max-w-3xl">
      <span class="text-xs font-extrabold text-indigo-700 bg-indigo-50 px-3 py-1.5 rounded-full">{category}</span>
      <h1 class="mt-4 text-3xl md:text-4xl font-black tracking-[-.04em]">{title}</h1>
      <p class="mt-3 text-slate-600 leading-7">{description}</p>
    </div>
    <div class="mt-8 card p-5 md:p-7 max-w-3xl">
      <slot />
    </div>
    {note && <p class="max-w-3xl mt-4 text-xs leading-5 text-slate-500">{note}</p>}
  </section>
</BaseLayout>
