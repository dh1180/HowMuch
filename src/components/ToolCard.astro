---
import type { ToolItem } from "../data/tools";
const { tool } = Astro.props as { tool: ToolItem };
---
<a
  href={tool.href}
  class="tool-card"
  data-name={tool.name}
  data-category={tool.category}
  data-keywords={tool.keywords.join(" ")}
>
  <div class="tool-card-top">
    <span class="tool-icon">{tool.icon}</span>
    <span class="tool-category">{tool.category}</span>
  </div>

  <div class="tool-card-body">
    <h2>{tool.name}</h2>
    <p>{tool.description}</p>
  </div>

  <div class="tool-example">
    <span>{tool.example}</span>
    <span class="tool-arrow" aria-hidden="true">→</span>
  </div>
</a>

<style>
  .tool-card {
    display: flex;
    flex-direction: column;
    padding: 20px;
    border: 1px solid #e6eaf0;
    border-radius: 19px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(15, 23, 42, .04);
    transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
  }

  .tool-card:hover {
    transform: translateY(-3px);
    border-color: #d8defc;
    box-shadow: 0 15px 35px rgba(15, 23, 42, .075);
  }

  .tool-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .tool-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: #eef2ff;
    color: #4f46e5;
    font-size: 16px;
    font-weight: 900;
  }

  .tool-category {
    padding: 5px 9px;
    border-radius: 999px;
    background: #f3f5f8;
    color: #64748b;
    font-size: 11px;
    font-weight: 800;
  }

  .tool-card-body {
    margin-top: 18px;
  }

  .tool-card-body h2 {
    margin: 0;
    color: #172033;
    font-size: 16px;
    line-height: 1.35;
    letter-spacing: -.025em;
    font-weight: 900;
  }

  .tool-card-body p {
    margin: 8px 0 0;
    color: #667085;
    font-size: 13px;
    line-height: 1.65;
  }

  .tool-example {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 17px;
    border-top: 1px solid #eef1f5;
    color: #4f46e5;
    font-size: 12px;
    font-weight: 850;
  }

  .tool-arrow {
    color: #818cf8;
    font-size: 16px;
    transition: transform .16s ease;
  }

  .tool-card:hover .tool-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 620px) {
    .tool-card {
      padding: 18px;
      border-radius: 17px;
    }

    .tool-icon {
      width: 39px;
      height: 39px;
      border-radius: 12px;
    }

    .tool-card-body {
      margin-top: 15px;
    }

    .tool-card-body h2 {
      font-size: 17px;
    }

    .tool-example {
      margin-top: 16px;
      padding-top: 14px;
      font-size: 13px;
    }
  }
</style>
